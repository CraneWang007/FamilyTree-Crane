<view class="container">
  <view class="home-head">
    <view class="home-welcome">
      <view class="serif home-title">家和万事兴</view>
      <view class="small muted">{{user.display_name || user.username}}，欢迎回来</view>
    </view>
    <button class="btn btn-sm" bindtap="openCreate">＋ 新建族谱</button>
  </view>

  <view class="section-head">
    <text class="section-title">我的族谱</text>
    <text class="tiny muted">{{myList.length}} 个</text>
  </view>

  <view class="empty" wx:if="{{!loading && !myList.length}}">还没有族谱，点击「新建族谱」开始</view>

  <view class="card" wx:for="{{myList}}" wx:key="id" bindtap="enterGenealogy" data-id="{{item.id}}">
    <view class="card-head">
      <text class="card-title">{{item.name}}</text>
      <text wx:if="{{item.isKinship}}" class="pill pill-kinship">亲戚谱</text>
      <text class="pill {{item.roleClass}}">{{item.roleLabel}}</text>
    </view>
    <view class="card-desc">{{item.description || '暂无简介'}}</view>
    <view class="card-meta">
      <text>成员 {{item.member_count}} 人</text>
      <text class="{{item.isKinship ? 'pill-kinship' : (item.isPublic ? 'pill-public' : 'pill-private')}}">{{item.visibilityText}}</text>
      <text wx:if="{{item.createdText}}">创建于 {{item.createdText}}</text>
    </view>
    <view class="card-actions">
      <button class="btn btn-sm btn-primary" catchtap="enterGenealogy" data-id="{{item.id}}">进入{{item.isKinship ? '亲戚谱' : '族谱'}}</button>
      <button wx:if="{{item.isAdmin && !item.isKinship}}" class="btn btn-sm" catchtap="toggleVisibility" data-id="{{item.id}}" data-next="{{item.nextVisibility}}">
        {{item.isPublic ? '设为私密' : '设为公开'}}
      </button>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">公开族谱</text>
    <text class="tiny muted">可浏览并申请加入</text>
  </view>

  <view class="empty" wx:if="{{!loading && !publicList.length}}">暂无公开族谱</view>

  <view class="card" wx:for="{{publicList}}" wx:key="id" bindtap="openPublic" data-id="{{item.id}}">
    <view class="card-head">
      <text class="card-title">{{item.name}}</text>
      <text wx:if="{{item.isDefault}}" class="pill pill-default">默认指引</text>
      <text wx:else class="pill pill-public">公开</text>
    </view>
    <view class="card-desc">{{item.description || '暂无简介'}}</view>
    <view class="card-meta">
      <text>成员 {{item.member_count}} 人</text>
      <text>{{item.generation_count}} 代</text>
      <text wx:if="{{item.isDefault && !item.is_member}}">免加入查看</text>
    </view>
    <view class="card-actions">
      <button class="btn btn-sm btn-primary {{item.pending_join && !item.canEnter ? 'is-disabled' : ''}}" catchtap="openPublic" data-id="{{item.id}}" disabled="{{item.pending_join && !item.canEnter}}">
        {{item.actionText}}
      </button>
    </view>
  </view>
</view>

<view class="mask" wx:if="{{showCreate}}" bindtap="closeCreate">
  <view class="dialog" catchtap="stop">
    <view class="dialog-title serif">新建族谱</view>
    <input class="input" placeholder="族谱名称，如：王氏家谱" value="{{newName}}" data-field="newName" bindinput="onCreateInput" />
    <textarea class="textarea" placeholder="简介（可选）" value="{{newDesc}}" data-field="newDesc" bindinput="onCreateInput" />
    <view class="dialog-actions">
      <button class="btn" bindtap="closeCreate">取消</button>
      <button class="btn btn-primary" loading="{{submitting}}" bindtap="createGenealogy">创建</button>
    </view>
  </view>
</view>
