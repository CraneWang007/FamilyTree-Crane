.pub-head {
  padding: 10rpx 4rpx 22rpx;
}

.pub-title {
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}

.tree-hint { padding: 4rpx 4rpx 12rpx; }

.tree-inner {
  display: inline-block;
  padding: 8rpx 8rpx 20rpx;
  min-width: 100%;
}

.join-panel {
  margin-top: 28rpx;
  padding: 26rpx;
  background: #fffdf8;
  border: 1rpx solid #e8dfcd;
  border-radius: 20rpx;
}

.pending-box {
  padding: 22rpx;
  background: #f7ecd6;
  color: #966b1f;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #dcd0ba;
  background: #fffdf7;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.picker-value { font-size: 26rpx; color: #2b2925; }
